  <script>
    // Stagger-reveal product cards as they scroll into view
    (function(){
      var cards = document.querySelectorAll('.product-card:not(.extra)');
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if(entry.isIntersecting){
            var i = Array.prototype.indexOf.call(cards, entry.target);
            entry.target.style.animationDelay = (i % 6) * 0.08 + 's';
            entry.target.classList.add('in-view');
            io.unobserve(entry.target);
          }
        });
      }, {threshold:0.15});
      cards.forEach(function(c){ io.observe(c); });
    })();

    // Collections modal: move hidden "extra" items into the modal grid,
    // then open it with a staggered entrance animation whenever it's triggered.
    (function(){
      var overlay = document.getElementById('collectionsModal');
      var grid = document.getElementById('modalGrid');
      var closeBtn = document.getElementById('modalClose');
      var triggers = Array.from(document.querySelectorAll('#viewAllBtn, a[href="#collections"]'));

      // Move the extra product cards out of the hidden main-grid slot
      // and into the modal, once, on load.
      document.querySelectorAll('.product-card.extra').forEach(function(card){
        card.classList.remove('extra');
        card.classList.remove('show');
        grid.appendChild(card);
      });

      function openModal(e){
        if(e) e.preventDefault();
        overlay.classList.add('open');
        document.body.classList.add('modal-locked');
        playSound('swoosh');
        var cards = grid.querySelectorAll('.product-card');
        cards.forEach(function(card, i){
          card.classList.remove('reveal');
          void card.offsetWidth;
          card.style.animationDelay = (i * 0.06) + 's';
          card.classList.add('reveal');
        });
      }
      function closeModal(){
        overlay.classList.remove('open');
        document.body.classList.remove('modal-locked');
        playSound('swoosh');
      }

      triggers.forEach(function(t){ t.addEventListener('click', openModal); });
      closeBtn.addEventListener('click', closeModal);
      overlay.addEventListener('click', function(e){
        if(e.target === overlay) closeModal();
      });
      document.addEventListener('keydown', function(e){
        if(e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
      });
    })();
    // Fade up the About section pieces as they scroll into view
    (function(){
      var els = document.querySelectorAll('.about-copy, .about-cards, .about-closing');
      var io2 = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if(entry.isIntersecting){
            entry.target.classList.add('in-view');
            io2.unobserve(entry.target);
          }
        });
      }, {threshold:0.15});
      els.forEach(function(el){ io2.observe(el); });
    })();

    // ============ SOUND EFFECTS ============
    // Real sound files should be added here. 
    // For now, we will use console logs and optional beeps.
    var SOUNDS_ENABLED = true;
    var SOUNDS = {
      addToCart: 'assets/sounds/add-to-cart.mp3',
      checkout: 'assets/sounds/checkout-success.mp3',
      wishlist: 'assets/sounds/wishlist.mp3',
      coupon: 'assets/sounds/coupon-applied.mp3',
      error: 'assets/sounds/error.mp3',
      swoosh: 'assets/sounds/swoosh.mp3',
      tick: 'assets/sounds/tick.mp3',
      remove: 'assets/sounds/remove.mp3',
      toggle: 'assets/sounds/toggle.mp3',
      click: 'assets/sounds/click.mp3'
    };
    
    function playSound(key){
      if(!SOUNDS_ENABLED) return;
      // If you have the files, uncomment the below lines and put the files in assets/sounds/
      /*
      try {
        var s = new Audio(SOUNDS[key]);
        s.volume = 0.5;
        s.play().catch(function(e){});
      } catch(e) { console.log("Sound failed:", key); }
      */
      console.log("Playing sound: " + key);
    }

    // ============ CART & WISHLIST SYSTEM ============
    // IMPORTANT: put your real WhatsApp business number here (with country code, no + or spaces)
    var WHATSAPP_NUMBER = "9707286520"; // <-- change this to your real number
    var ADMIN_PASSWORD = "admin123";

    var cart = JSON.parse(localStorage.getItem('js_cart') || '[]');
    var wishlist = JSON.parse(localStorage.getItem('js_wishlist') || '[]');

    function saveCart(){ localStorage.setItem('js_cart', JSON.stringify(cart)); renderCart(); updateCartCount(); }
    function saveWishlist(){ localStorage.setItem('js_wishlist', JSON.stringify(wishlist)); renderWishlist(); updateWishlistCount(); }

    function getProductFromCard(card){
      var img = card.querySelector('.product-thumb img');
      var name = card.querySelector('h3');
      var price = card.querySelector('.price');
      var sizeBtn = card.querySelector('.size-pill.selected');
      var size = sizeBtn ? sizeBtn.getAttribute('data-size') : null;
      var baseName = name ? name.textContent.trim() : 'Item';
      return {
        id: baseName + (size ? (' - ' + size) : ''),
        name: baseName,
        size: size,
        price: price ? parseInt(price.textContent.replace(/[^\d]/g,''), 10) : 0,
        img: img ? img.getAttribute('src') : ''
      };
    }

    // Size pill selection
    (function(){
      document.querySelectorAll('.product-card').forEach(function(card){
        card.querySelectorAll('.size-pill').forEach(function(pill){
          pill.addEventListener('click', function(){
            card.querySelectorAll('.size-pill').forEach(function(p){ p.classList.remove('selected'); });
            pill.classList.add('selected');
            playSound('click');
          });
        });
      });
    })();

    function addToCart(product, qty){
      qty = qty || 1;
      var existing = cart.find(function(i){ return i.id === product.id; });
      if(existing){ existing.qty += qty; }
      else { product.qty = qty; cart.push(product); }
      saveCart();
    }

    function updateCartCount(){
      var count = cart.reduce(function(sum, i){ return sum + i.qty; }, 0);
      var el = document.getElementById('cartCount');
      if(el) el.textContent = count;
    }
    function updateWishlistCount(){
      var el = document.getElementById('wishlistCount');
      if(el) el.textContent = wishlist.length;
    }

    var appliedCoupon = null; // { code, type: 'percent'|'flat', value }
    var COUPONS = {
      'JSNEW15': { type: 'percent', value: 15 },
      'FLAT100': { type: 'flat', value: 100 }
    };

    function computeTotals(){
      var subtotal = cart.reduce(function(s,i){ return s + i.price * i.qty; }, 0);
      var discount = 0;
      if(appliedCoupon){
        discount = appliedCoupon.type === 'percent'
          ? Math.round(subtotal * appliedCoupon.value / 100)
          : Math.min(appliedCoupon.value, subtotal);
      }
      return { subtotal: subtotal, discount: discount, total: Math.max(subtotal - discount, 0) };
    }

    function renderCart(){
      var body = document.getElementById('cartBody');
      var foot = document.getElementById('cartFoot');
      if(!body) return;
      if(cart.length === 0){
        body.innerHTML = '<div class="drawer-empty">Your cart is empty.</div>';
        foot.style.display = 'none';
        return;
      }
      foot.style.display = 'block';
      body.innerHTML = cart.map(function(item, idx){
        return '<div class="drawer-item">' +
          '<img src="' + item.img + '" alt="' + item.name + '">' +
          '<div class="drawer-item-info">' +
            '<h4>' + item.name + (item.size ? ' <span style="color:var(--ink-faint);font-weight:400;">(Size: ' + item.size + ')</span>' : '') + '</h4>' +
            '<div class="price">₹' + item.price + '</div>' +
            '<div class="qty-row">' +
              '<button class="qty-btn" data-action="dec" data-idx="' + idx + '">−</button>' +
              '<span class="qty-val">' + item.qty + '</span>' +
              '<button class="qty-btn" data-action="inc" data-idx="' + idx + '">+</button>' +
              '<button class="drawer-item-remove" data-action="remove" data-idx="' + idx + '">Remove</button>' +
            '</div>' +
          '</div>' +
        '</div>';
      }).join('');

      var totals = computeTotals();
      document.getElementById('cartLineSubtotal').textContent = '₹' + totals.subtotal;
      var discountLine = document.getElementById('discountLine');
      if(totals.discount > 0){
        discountLine.style.display = 'flex';
        document.getElementById('cartLineDiscount').textContent = '−₹' + totals.discount;
      } else {
        discountLine.style.display = 'none';
      }
      document.getElementById('cartSubtotal').textContent = '₹' + totals.total;

      body.querySelectorAll('[data-action]').forEach(function(btn){
        btn.addEventListener('click', function(){
          var idx = parseInt(btn.getAttribute('data-idx'), 10);
          var action = btn.getAttribute('data-action');
          if(action === 'inc'){ cart[idx].qty++; playSound('click'); }
          if(action === 'dec'){ cart[idx].qty--; playSound('click'); if(cart[idx].qty <= 0){ cart.splice(idx,1); playSound('remove'); } }
          if(action === 'remove'){ cart.splice(idx,1); playSound('remove'); }
          saveCart();
        });
      });
    }

    function renderWishlist(){
      var body = document.getElementById('wishlistBody');
      if(!body) return;
      if(wishlist.length === 0){
        body.innerHTML = '<div class="drawer-empty">Your wishlist is empty.</div>';
        return;
      }
      body.innerHTML = wishlist.map(function(item, idx){
        return '<div class="drawer-item">' +
          '<img src="' + item.img + '" alt="' + item.name + '">' +
          '<div class="drawer-item-info">' +
            '<h4>' + item.name + '</h4>' +
            '<div class="price">₹' + item.price + '</div>' +
            '<div class="qty-row">' +
              '<button class="drawer-item-move" data-action="move" data-idx="' + idx + '">Move to Cart</button>' +
              '<button class="drawer-item-remove" data-action="remove" data-idx="' + idx + '">Remove</button>' +
            '</div>' +
          '</div>' +
        '</div>';
      }).join('');

      body.querySelectorAll('[data-action]').forEach(function(btn){
        btn.addEventListener('click', function(){
          var idx = parseInt(btn.getAttribute('data-idx'), 10);
          var action = btn.getAttribute('data-action');
          if(action === 'move'){
            addToCart(Object.assign({}, wishlist[idx]), 1);
            wishlist.splice(idx,1);
            playSound('addToCart');
          }
          if(action === 'remove'){ wishlist.splice(idx,1); playSound('remove'); }
          saveWishlist();
        });
      });
    }

    // Toast helper
    function showToast(msg){
      var toast = document.getElementById('toast');
      var text = document.getElementById('toastText');
      text.textContent = msg;
      toast.classList.add('show');
      clearTimeout(showToast._t);
      showToast._t = setTimeout(function(){ toast.classList.remove('show'); }, 1800);
    }

    // Drawer open/close helpers
    function openDrawer(id){ document.getElementById(id).classList.add('open'); document.body.classList.add('modal-locked'); playSound('swoosh'); }
    function closeDrawer(id){ document.getElementById(id).classList.remove('open'); document.body.classList.remove('modal-locked'); playSound('swoosh'); }

    document.getElementById('cartIcon').addEventListener('click', function(){ renderCart(); openDrawer('cartOverlay'); });
    document.getElementById('cartDrawerClose').addEventListener('click', function(){ closeDrawer('cartOverlay'); });
    document.getElementById('cartOverlay').addEventListener('click', function(e){ if(e.target === this) closeDrawer('cartOverlay'); });

    document.getElementById('wishlistIcon').addEventListener('click', function(){ renderWishlist(); openDrawer('wishlistOverlay'); });
    document.getElementById('wishlistDrawerClose').addEventListener('click', function(){ closeDrawer('wishlistOverlay'); });
    document.getElementById('wishlistOverlay').addEventListener('click', function(e){ if(e.target === this) closeDrawer('wishlistOverlay'); });

    // Add to Cart buttons
    (function(){
      var cartIcon = document.getElementById('cartIcon');
      document.querySelectorAll('.add-btn').forEach(function(btn){
        btn.addEventListener('click', function(){
          var card = btn.closest('.product-card');
          var product = getProductFromCard(card);
          addToCart(product, 1);
          playSound('addToCart');
          cartIcon.classList.remove('cart-bump');
          void cartIcon.offsetWidth;
          cartIcon.classList.add('cart-bump');
          showToast(product.name + ' added to cart');
          btn.classList.add('added');
          var original = btn.innerHTML;
          btn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>Added';
          setTimeout(function(){
            btn.classList.remove('added');
            btn.innerHTML = original;
          }, 1200);
        });
      });
    })();

    // Buy Now buttons — add to cart then jump straight to checkout
    (function(){
      document.querySelectorAll('.buy-btn').forEach(function(btn){
        btn.addEventListener('click', function(){
          var card = btn.closest('.product-card');
          var product = getProductFromCard(card);
          addToCart(product, 1);
          playSound('addToCart');
          renderCart();
          openDrawer('cartOverlay');
        });
      });
    })();

    // Wishlist hearts
    (function(){
      document.querySelectorAll('.wish').forEach(function(w){
        w.addEventListener('click', function(){
          var card = w.closest('.product-card');
          var product = getProductFromCard(card);
          var existingIdx = wishlist.findIndex(function(i){ return i.id === product.id; });
          if(existingIdx === -1){
            wishlist.push(product);
            w.classList.add('liked');
            playSound('wishlist');
            showToast(product.name + ' added to wishlist');
          } else {
            wishlist.splice(existingIdx, 1);
            w.classList.remove('liked');
          }
          saveWishlist();
        });
      });
      // restore liked state on load
      document.querySelectorAll('.product-card').forEach(function(card){
        var product = getProductFromCard(card);
        var w = card.querySelector('.wish');
        if(w && wishlist.some(function(i){ return i.id === product.id; })){
          w.classList.add('liked');
        }
      });
    })();

    // Coupon apply
    (function(){
      var btn = document.getElementById('couponApplyBtn');
      if(!btn) return;
      btn.addEventListener('click', function(){
        var input = document.getElementById('couponInput');
        var msg = document.getElementById('couponMsg');
        var code = input.value.trim().toUpperCase();
        if(COUPONS[code]){
          appliedCoupon = Object.assign({ code: code }, COUPONS[code]);
          msg.textContent = 'Coupon "' + code + '" applied!';
          msg.className = 'coupon-msg ok';
          playSound('coupon');
        } else {
          appliedCoupon = null;
          msg.textContent = 'Invalid coupon code.';
          msg.className = 'coupon-msg err';
          playSound('error');
        }
        renderCart();
      });
    })();

    // Payment option highlight
    (function(){
      document.querySelectorAll('.pay-option').forEach(function(opt){
        opt.addEventListener('click', function(){
          document.querySelectorAll('.pay-option').forEach(function(o){ o.classList.remove('selected'); });
          opt.classList.add('selected');
        });
      });
    })();

    // Orders (order history) stored locally on this device
    var orders = JSON.parse(localStorage.getItem('js_orders') || '[]');
    function saveOrders(){ localStorage.setItem('js_orders', JSON.stringify(orders)); }

    function renderOrders(){
      var body = document.getElementById('ordersBody');
      var adminBody = document.getElementById('adminBody');
      
      // Normal user orders
      if(body){
        if(orders.length === 0){
          body.innerHTML = '<div class="drawer-empty">No orders yet. Your placed orders will show up here on this device.</div>';
        } else {
          body.innerHTML = orders.slice().reverse().map(function(order){
            var itemsText = order.items.map(function(i){ return i.name + (i.size ? ' (' + i.size + ')' : '') + ' x' + i.qty; }).join(', ');
            return '<div class="order-card">' +
              '<div class="order-card-head"><span class="oid">Order #' + order.id + '</span><span class="odate">' + order.date + '</span></div>' +
              '<div class="order-items-mini">' + itemsText + '</div>' +
              '<div class="order-total-line">Total: <strong>₹' + order.total + '</strong> · ' + order.payment + '</div>' +
              '<div class="status-stepper">' +
                '<div class="status-step done"><div class="dot2"></div><span>Placed</span></div>' +
                '<div class="status-step"><div class="dot2"></div><span>Packed</span></div>' +
                '<div class="status-step"><div class="dot2"></div><span>Shipped</span></div>' +
                '<div class="status-step"><div class="dot2"></div><span>Delivered</span></div>' +
              '</div>' +
              '<div class="order-actions">' +
                '<button data-track="' + order.id + '">Track Order</button>' +
                '<button data-return="' + order.id + '">Return / Exchange</button>' +
              '</div>' +
            '</div>';
          }).join('');
        }
        body.querySelectorAll('[data-track]').forEach(function(b){
          b.addEventListener('click', function(){
            playSound('click');
            showToast('Order #' + b.getAttribute('data-track') + ' is currently: Placed.');
          });
        });
        body.querySelectorAll('[data-return]').forEach(function(b){
          b.addEventListener('click', function(){
            playSound('swoosh');
            var msg = encodeURIComponent('Hi, I would like to request a return/exchange for Order #' + b.getAttribute('data-return') + '.');
            window.open('https://wa.me/' + WHATSAPP_NUMBER + '?text=' + msg, '_blank');
          });
        });
      }

      // Admin view
      if(adminBody){
         if(orders.length === 0){
          adminBody.innerHTML = '<div class="drawer-empty">No orders available.</div>';
        } else {
          adminBody.innerHTML = orders.slice().reverse().map(function(order){
            var itemsText = order.items.map(function(i){ return i.name + ' x' + i.qty; }).join(', ');
            return '<div class="order-card">' +
              '<div class="order-card-head"><span class="oid">Order #' + order.id + '</span><span class="odate">' + order.date + '</span></div>' +
              '<div class="order-items-mini">' + itemsText + '</div>' +
              '<div class="order-total-line">Total: <strong>₹' + order.total + '</strong></div>' +
              '<div class="status-stepper">' +
                '<div class="status-step done"><div class="dot2"></div><span>Placed</span></div>' +
                '<div class="status-step"><div class="dot2"></div><span>Packed</span></div>' +
                '<div class="status-step"><div class="dot2"></div><span>Shipped</span></div>' +
                '<div class="status-step"><div class="dot2"></div><span>Delivered</span></div>' +
              '</div>' +
            '</div>';
          }).join('');
        }
      }
    }

    document.getElementById('accountIcon').addEventListener('click', function(){
      renderOrders();
      openDrawer('ordersOverlay');
    });
    document.getElementById('ordersDrawerClose').addEventListener('click', function(){ closeDrawer('ordersOverlay'); });
    document.getElementById('ordersOverlay').addEventListener('click', function(e){ if(e.target === this) closeDrawer('ordersOverlay'); });

    // Settings Drawer
    document.getElementById('settingsIcon').addEventListener('click', function(){
      openDrawer('settingsOverlay');
    });
    document.getElementById('settingsDrawerClose').addEventListener('click', function(){ closeDrawer('settingsOverlay'); });
    document.getElementById('settingsOverlay').addEventListener('click', function(e){ if(e.target === this) closeDrawer('settingsOverlay'); });

    // Theme Toggle
    document.getElementById('themeToggle').addEventListener('click', function(){
      var root = document.documentElement;
      var newTheme = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', newTheme);
      playSound('toggle');
    });

    // Sound Toggle
    document.getElementById('soundToggle').addEventListener('click', function(){
      SOUNDS_ENABLED = !SOUNDS_ENABLED;
      this.textContent = SOUNDS_ENABLED ? "Mute Sounds" : "Enable Sounds";
      playSound('toggle');
    });

    // Admin Dashboard
    document.getElementById('adminToggle').addEventListener('click', function(){
      var pass = prompt("Enter Admin Password:");
      if(pass === ADMIN_PASSWORD){
        closeDrawer('settingsOverlay');
        renderOrders();
        document.getElementById('adminModal').classList.add('open');
        document.body.classList.add('modal-locked');
      } else if(pass !== null) { alert("Wrong Password!"); playSound('error'); }
    });
    document.getElementById('adminModalClose').addEventListener('click', function(){
      document.getElementById('adminModal').classList.remove('open');
      document.body.classList.remove('modal-locked');
    });

    // Checkout via WhatsApp — builds an order-details message from the cart,
    // includes address + payment method, applies any coupon, and saves the order to history.
    (function(){
      var btn = document.getElementById('checkoutBtn');
      if(!btn) return;
      btn.addEventListener('click', function(){
        if(cart.length === 0) return;
        var address = document.getElementById('deliveryAddress').value.trim();
        if(!address){
          showToast('Please add a delivery address before placing your order.');
          document.getElementById('deliveryAddress').focus();
          playSound('error');
          return;
        }
        var payMethod = document.querySelector('input[name="payMethod"]:checked').value;
        var totals = computeTotals();

        var lines = ['Hi JS Asthetic Ways! I would like to place an order:', ''];
        cart.forEach(function(item){
          lines.push('• ' + item.name + (item.size ? ' (Size: ' + item.size + ')' : '') + ' x' + item.qty + ' — ₹' + (item.price * item.qty));
        });
        lines.push('', 'Subtotal: ₹' + totals.subtotal);
        if(totals.discount > 0) lines.push('Discount (' + appliedCoupon.code + '): −₹' + totals.discount);
        lines.push('Total: ₹' + totals.total);
        lines.push('', 'Payment Method: ' + payMethod);
        lines.push('Delivery Address: ' + address);

        var orderId = Date.now().toString().slice(-6);
        lines.push('', 'Order Ref: #' + orderId);

        var msg = encodeURIComponent(lines.join('\n'));
        window.open('https://wa.me/' + WHATSAPP_NUMBER + '?text=' + msg, '_blank');
        playSound('checkout');

        orders.push({
          id: orderId,
          date: new Date().toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }),
          items: cart.map(function(i){ return { name: i.name, size: i.size, qty: i.qty }; }),
          total: totals.total,
          payment: payMethod
        });
        saveOrders();

        cart = [];
        appliedCoupon = null;
        saveCart();
        document.getElementById('deliveryAddress').value = '';
        document.getElementById('couponInput').value = '';
        document.getElementById('couponMsg').textContent = '';
        closeDrawer('cartOverlay');
        showToast('Order placed! Confirm details on WhatsApp.');
      });
    })();

    // FAQ accordion
    (function(){
      document.querySelectorAll('.faq-item').forEach(function(item){
        item.querySelector('.faq-q').addEventListener('click', function(){
          var wasOpen = item.classList.contains('open');
          document.querySelectorAll('.faq-item').forEach(function(i){ i.classList.remove('open'); });
          if(!wasOpen) item.classList.add('open');
          playSound('toggle');
        });
      });
    })();

    // Floating WhatsApp support button
    (function(){
      var wa = document.getElementById('waFloat');
      if(!wa) return;
      wa.addEventListener('click', function(){
        playSound('swoosh');
        var msg = encodeURIComponent('Hi JS Asthetic Ways! I need some help.');
        window.open('https://wa.me/' + WHATSAPP_NUMBER + '?text=' + msg, '_blank');
      });
    })();

    // Search icon scrolls to shop and focuses the search box
    (function(){
      var icon = document.getElementById('searchIcon');
      if(!icon) return;
      icon.addEventListener('click', function(){
        playSound('click');
        document.getElementById('shop').scrollIntoView({behavior:'smooth'});
        setTimeout(function(){ document.getElementById('productSearch').focus(); }, 400);
      });
    })();

    // Search + Category filter + Sort for the main product grid
    (function(){
      var grid = document.getElementById('productGrid');
      var searchInput = document.getElementById('productSearch');
      var sortSelect = document.getElementById('sortSelect');
      var catTabs = document.querySelectorAll('.cat-tab');
      if(!grid) return;
      var cards = Array.prototype.slice.call(grid.querySelectorAll('.product-card'));
      var activeCat = 'all';

      function applyFilters(){
        var query = searchInput.value.trim().toLowerCase();
        var visible = cards.filter(function(card){
          var name = card.querySelector('h3').textContent.toLowerCase();
          var cat = card.getAttribute('data-category');
          var matchesCat = activeCat === 'all' || cat === activeCat;
          var matchesSearch = !query || name.indexOf(query) !== -1;
          var show = matchesCat && matchesSearch;
          card.style.display = show ? '' : 'none';
          return show;
        });

        // remove any existing no-results message
        var existingMsg = grid.querySelector('.no-results');
        if(existingMsg) existingMsg.remove();
        if(visible.length === 0){
          var msg = document.createElement('div');
          msg.className = 'no-results';
          msg.textContent = 'No products match your search.';
          grid.appendChild(msg);
        }

        applySort(visible);
      }

      function applySort(visible){
        var sortVal = sortSelect.value;
        if(sortVal === 'featured') return;
        var sorted = visible.slice().sort(function(a, b){
          var pa = parseInt(a.getAttribute('data-price'), 10);
          var pb = parseInt(b.getAttribute('data-price'), 10);
          return sortVal === 'low-high' ? pa - pb : pb - pa;
        });
        sorted.forEach(function(card){ grid.appendChild(card); });
      }

      searchInput.addEventListener('input', applyFilters);
      sortSelect.addEventListener('change', function(){ playSound('tick'); applyFilters(); });
      catTabs.forEach(function(tab){
        tab.addEventListener('click', function(){
          catTabs.forEach(function(t){ t.classList.remove('active'); });
          tab.classList.add('active');
          activeCat = tab.getAttribute('data-cat');
          playSound('tick');
          applyFilters();
        });
      });
    })();

    // Promo banner CTA scrolls to the shop section
    (function(){
      var btn = document.getElementById('promoShopBtn');
      if(!btn) return;
      btn.addEventListener('click', function(){
        playSound('swoosh');
        document.getElementById('shop').scrollIntoView({behavior:'smooth'});
      });
    })();

    // Newsletter form
    (function(){
      var form = document.querySelector('.news-form');
      if(!form) return;
      form.addEventListener('submit', function(e){
        e.preventDefault();
        var input = form.querySelector('input');
        if(input && input.value){
          playSound('coupon');
          showToast('Subscribed! Welcome to the JS family');
          input.value = '';
        }
      });
    })();

    // Mobile menu toggle
    (function(){
      var toggle = document.querySelector('.menu-toggle');
      var links = document.querySelector('.nav-links');
      if(!toggle || !links) return;
      toggle.addEventListener('click', function(){
        links.classList.toggle('mobile-open');
        toggle.classList.toggle('open');
        playSound('toggle');
      });
      links.querySelectorAll('a').forEach(function(a){
        a.addEventListener('click', function(){
          links.classList.remove('mobile-open');
          toggle.classList.remove('open');
        });
      });
    })();

    // Initial render
    updateCartCount();
    updateWishlistCount();
  </script>
</body>
</html>
